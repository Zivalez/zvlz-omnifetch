{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "0.1.0",
  "description": "Detects media on the active tab and only offers downloads that are verified complete. Everything runs locally.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Media Downloader",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "downloads",
    "downloads.open",
    "favicon",
    "clipboardWrite",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "webRequest",
    "webNavigation",
    "scripting",
    "alarms",
    "contextMenus",
    "cookies",
    "sidePanel",
    "tabCapture",
    "declarativeNetRequest",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}